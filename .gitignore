# Secrets
.env
.env.local
.env.bak
*.sessionid
.ig_sessionid

# Node
node_modules/
dist/
build/
.vite/

# Dashboard data is generated from analytics/snapshots by sync-data.mjs
dashboard/public/data/
*.log
npm-debug.log*

# Python
__pycache__/
*.pyc
.venv/
venv/

# Large media (keep the bank's structure + small frames, not raw video)
content-bank/reels/**/*.mp4
content-bank/scraped/**
production/**/out/
production/**/output/
*.mov

# OS
.DS_Store
Thumbs.db

# Remixed reels are generated from the bank by production/remix.py, plus the local
# publish queue (captions awaiting approval). Both are working state, not source.
production/remixes/
*.mp4

# Secrets: login cookies, tokens (never commit)
secrets/
*cookies*.txt

# local video working files (big media lives on the "media" GitHub release)
media/
*.render.mp4

# Reel working media (photos of people, b-roll, A-rolls, renders) stay out of git
production/reels/*/assets/media/
production/reels/*/assets/aroll*
production/reels/*/snapshots/
production/reels/*/node_modules/

# control center build output (made by tools/control/build_data.py at deploy time)
control-site/public/data.json
control-site/public/covers/
control-site/.impeccable/review/
control-site/.impeccable/mocks/
control-site/.impeccable/questions/
control-site/public/videos/
control-site/public/style/
